# ============================================
# 織光 APP — 環境變數範本
# ============================================
# 複製此檔案為 .env（不要提交到 Git）
# cp .env.example .env
# ============================================

# ── Supabase ──────────────────────────────────
# 從 Supabase Dashboard → Settings → API 取得
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Gemini AI ─────────────────────────────────
# 從 https://aistudio.google.com/apikey 取得
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# ── 藍新金流（Phase 4）─────────────────────────
# VITE_NEWEBPAY_MERCHANT_ID=your-merchant-id
# VITE_NEWEBPAY_HASH_KEY=your-hash-key
# VITE_NEWEBPAY_HASH_IV=your-hash-iv
